{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/shared/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    // The byte-column model, so the EBCDIC integration test can hold the engine's boundaries against
    // the ones the editor recomputes locally. It is pure arithmetic and pulls in no browser API.
    "src/renderer/src/model/columns.ts"
  ]
}
