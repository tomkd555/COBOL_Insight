{
  "name": "cobol-insight-gui",
  "version": "2.0.0",
  "private": true,
  "description": "COBOL Insight V2 desktop GUI (electron-vite + React, offline, every dependency bundled locally)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "smoke:render": "electron-vite build && electron smoke/render.cjs",
    "smoke:shots": "electron-vite build && electron smoke/render.cjs --shots out/screenshots",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "5.2.0",
    "7zip-bin": "5.2.0",
    "cytoscape": "3.34.2",
    "cytoscape-elk": "2.3.0",
    "electron": "38.8.6",
    "electron-builder": "26.15.7",
    "electron-vite": "4.0.1",
    "elkjs": "0.12.0",
    "jsdom": "26.1.0",
    "monaco-editor": "0.56.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
