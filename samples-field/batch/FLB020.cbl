000100*=================================================================
000200* PROGRAM-ID : FLB020
000300* 機能       : 入金消込
000400* 処理概要   : 未処理の契約を支店コードで絞り込んで取り出し、
000500*              入金明細を消込済みに更新して消込表へ登録します。
000600*              続けて販売店単位に契約残高を減額します。
000700* 起動元     : FLJ010 STEP040（IKJEFT01 の DSN RUN）
000800* 呼び出し先 : FLS010、WS-PGM-NAME が示す集計副プログラム
000900*=================================================================
001000 IDENTIFICATION DIVISION.
001100 PROGRAM-ID.    FLB020.
001200 AUTHOR.        FL-BATCH-TEAM.
001300 DATE-WRITTEN.  2021-06-01.
001400*
001500 ENVIRONMENT DIVISION.
001600 CONFIGURATION SECTION.
001700 SOURCE-COMPUTER. IBM-370.
001800 OBJECT-COMPUTER. IBM-370.
001900*
002000 DATA DIVISION.
002100 WORKING-STORAGE SECTION.
002200*
002300     EXEC SQL INCLUDE SQLCA END-EXEC.
002400     EXEC SQL INCLUDE FLD010 END-EXEC.
002500*
002600* 起動パラメーター
002700 01  WS-PARM-AREA.
002800     05  WS-PARM-BRANCH             PIC X(03).
002900     05  WS-PARM-HANBAITEN          PIC X(05).
003000     05  FILLER                     PIC X(72).
003100*
003200* ホスト変数
003300 01  WS-HOST-VARS.
003400     05  WS-BRANCH-CD               PIC X(03) VALUE SPACE.
003500     05  WS-HANBAITEN-CD            PIC X(05) VALUE SPACE.
003600     05  WS-HANBAITEN-MEI           PIC X(30) VALUE SPACE.
003700     05  WS-HANBAITEN-MEI-IND       PIC S9(04) COMP VALUE ZERO.
003800     05  WS-KOSHIN-YMD              PIC X(08) VALUE SPACE.
003900     05  WS-KOSHIN-YMD-IND          PIC S9(04) COMP VALUE ZERO.
004000     05  WS-DATE                    PIC X(08) VALUE SPACE.
004100     05  WS-NYUKIN-GAKU             PIC S9(11)V USAGE COMP-3.
004200     05  WS-NYUKIN-CNT              PIC S9(09) COMP VALUE ZERO.
004300     05  WS-UPD-KEIYAKU-NO          PIC X(10) VALUE SPACE.
004400     05  WS-UPD-ZANDAKA             PIC S9(11)V USAGE COMP-3.
004500*
004600* 作業領域
004700 01  WS-WORK-AREA.
004800     05  WS-WK-DATE                 PIC 9(08) VALUE ZERO.
004900     05  WS-HYOJI-MEI               PIC X(30) VALUE SPACE.
005000     05  WS-COMMIT-CNT              PIC S9(04) COMP VALUE ZERO.
005100     05  WS-COMMIT-MAX              PIC S9(04) COMP VALUE 500.    CHG25003
005200     05  WS-PGM-NAME                PIC X(08) VALUE 'FLS020'.     CHG25003
005300 01  WS-ERR-MSG                     PIC X(60) VALUE SPACE.
005400*
005500* FLS010 への受け渡し領域
005600 01  WS-ERR-AREA.
005700     05  WS-ERR-PGM                 PIC X(08) VALUE 'FLB020  '.
005800     05  WS-ERR-CODE                PIC X(04) VALUE SPACE.
005900     05  WS-ERR-TEXT                PIC X(60) VALUE SPACE.
006000*
006100* 件数
006200 01  WS-COUNTERS.
006300     05  WS-READ-CNT                PIC 9(07) VALUE ZERO.
006400     05  WS-UPD-CNT                 PIC 9(07) VALUE ZERO.
006500     05  WS-INS-CNT                 PIC 9(07) VALUE ZERO.
006600     05  WS-ZAN-CNT                 PIC 9(07) VALUE ZERO.
006700     05  WS-LOG-CNT                 PIC 9(07) VALUE ZERO.
006800*
006900* 未処理契約の読み出しカーソル
007000     EXEC SQL DECLARE CSR-KEIYAKU CURSOR FOR
007100         SELECT *
007200           FROM FLDB.KEIYAKU
007300          WHERE SUBSTR(KEIYAKU_NO, 1, 3) = :WS-BRANCH-CD
007400            AND SHORI_KBN = '0'
007500     END-EXEC.
007600*
007700* 残高更新用のカーソル
007800     EXEC SQL DECLARE CSR-UPD CURSOR FOR
007900         SELECT KEIYAKU_NO, ZANDAKA
008000           FROM FLDB.KEIYAKU
008100          WHERE HANBAITEN_CD = :WS-HANBAITEN-CD
008200          FOR UPDATE OF ZANDAKA, KOSHIN_YMD
008300     END-EXEC.
008400*
008500 PROCEDURE DIVISION.
008600*
008700*----- 主処理 ----------------------------------------------------
008800 0000-MAIN.
008900     EXEC SQL WHENEVER SQLERROR GO TO 9900-SQL-ERROR END-EXEC
009000     PERFORM 1000-INIT
009100     PERFORM 2000-KESHIKOMI
009200     PERFORM 3000-ZANDAKA-UPD
009300     PERFORM 3300-CALL-SHUKEI
009400     PERFORM 8000-END
009500     STOP RUN.
009600*
009700*----- 初期処理 --------------------------------------------------
009800 1000-INIT.
009900     ACCEPT WS-PARM-AREA
010000     MOVE WS-PARM-BRANCH    TO WS-BRANCH-CD
010100     MOVE WS-PARM-HANBAITEN TO WS-HANBAITEN-CD
010200     ACCEPT WS-WK-DATE FROM DATE YYYYMMDD
010300     MOVE WS-WK-DATE TO WS-DATE
010400     DISPLAY 'FLB020 入金消込を開始します。'
010500     DISPLAY '  支店コード   = ' WS-BRANCH-CD
010600     DISPLAY '  販売店コード = ' WS-HANBAITEN-CD.
010700*
010800*----- 入金消込 --------------------------------------------------
010900 2000-KESHIKOMI.
011000     EXEC SQL OPEN CSR-KEIYAKU END-EXEC
011100     IF SQLCODE NOT = 0
011200         MOVE '契約カーソルの開始に失敗しました' TO WS-ERR-MSG
011300         PERFORM 9900-SQL-ERROR
011400     END-IF
011500     PERFORM 2100-FETCH-LOOP UNTIL SQLCODE NOT = 0
011600     EXEC SQL CLOSE CSR-KEIYAKU END-EXEC.
011700*
011800 2100-FETCH-LOOP.
011900     EXEC SQL
012000         FETCH CSR-KEIYAKU INTO :DCLKEIYAKU
012100     END-EXEC
012200     EVALUATE SQLCODE
012300         WHEN 0
012400             PERFORM 2200-KESHIKOMI-1KEN
012500         WHEN +100
012600             CONTINUE
012700         WHEN OTHER
012800             PERFORM 9900-SQL-ERROR
012900     END-EVALUATE.
013000*
013100 2200-KESHIKOMI-1KEN.
013200     ADD 1 TO WS-READ-CNT
013300*    販売店名を引き当てます。
013400     EXEC SQL
013500         SELECT HANBAITEN_MEI, KOSHIN_YMD
013600           INTO :WS-HANBAITEN-MEI :WS-HANBAITEN-MEI-IND,
013650                :WS-KOSHIN-YMD :WS-KOSHIN-YMD-IND
013700           FROM FLDB.HANBAITEN
013800          WHERE HANBAITEN_CD = :HANBAITEN-CD
013900     END-EXEC
014000     MOVE WS-HANBAITEN-MEI TO WS-HYOJI-MEI
014100*    未消込の入金明細の件数を数えます。
014200     EXEC SQL
014300         SELECT COUNT(*)
014400           INTO :WS-NYUKIN-CNT
014500           FROM FLDB.NYUKIN
014600          WHERE KEIYAKU_NO = :KEIYAKU-NO
014700            AND SHORI_KBN = '0'
014800     END-EXEC
014900     EVALUATE SQLCODE
015000         WHEN 0
015100             CONTINUE
015200         WHEN +100
015300             MOVE ZERO TO WS-NYUKIN-CNT
015400         WHEN OTHER
015500             PERFORM 9900-SQL-ERROR
015600     END-EVALUATE
015700     IF WS-NYUKIN-CNT > ZERO
015800         MOVE ZANDAKA TO WS-NYUKIN-GAKU
015900         PERFORM 2300-UPDATE-NYUKIN
016000         PERFORM 2400-INSERT-KESHIKOMI
016100         PERFORM 2500-LOG-KESHIKOMI
016200     END-IF
016300     PERFORM 2900-COMMIT-CHECK.
016400*
016500 2300-UPDATE-NYUKIN.
016600     EXEC SQL
016700         UPDATE FLDB.NYUKIN
016800            SET SHORI_KBN = '1',
016900                KOSHIN_YMD = :WS-DATE
017000          WHERE KEIYAKU_NO = :KEIYAKU-NO
017100     END-EXEC
017200     ADD 1 TO WS-UPD-CNT.
017300*
017400 2400-INSERT-KESHIKOMI.
017500     EXEC SQL
017600         INSERT INTO FLDB.KESHIKOMI
017700                ( KEIYAKU_NO, KESHIKOMI_YMD, KESHIKOMI_GAKU )
017800         VALUES ( :KEIYAKU-NO, :WS-DATE, :WS-NYUKIN-GAKU )
017900     END-EXEC
018000     IF SQLCODE NOT = 0
018100         MOVE '消込明細の登録に失敗しました' TO WS-ERR-MSG
018200         PERFORM 9900-SQL-ERROR
018300     END-IF
018400     ADD 1 TO WS-INS-CNT.
018500*
018600 2500-LOG-KESHIKOMI.
018700     MOVE '0000' TO WS-ERR-CODE
018800     MOVE '消込を登録しました' TO WS-ERR-TEXT
018900     CALL 'FLS010' USING WS-ERR-AREA                              CHG25003
019000     ADD 1 TO WS-LOG-CNT.
019100*
019200 2900-COMMIT-CHECK.
019300     ADD 1 TO WS-COMMIT-CNT
019400     IF WS-COMMIT-CNT >= WS-COMMIT-MAX
019500         EXEC SQL COMMIT END-EXEC
019600         MOVE ZERO TO WS-COMMIT-CNT
019700     END-IF.
019800*
019900*----- 契約残高の更新 --------------------------------------------
020000 3000-ZANDAKA-UPD.
020100     EXEC SQL OPEN CSR-UPD END-EXEC
020200     IF SQLCODE NOT = 0
020300         MOVE '残高カーソルの開始に失敗しました' TO WS-ERR-MSG
020400         PERFORM 9900-SQL-ERROR
020500     END-IF
020600     PERFORM 3100-UPD-LOOP UNTIL SQLCODE NOT = 0
020700     EXEC SQL CLOSE CSR-UPD END-EXEC.
020800*
020900 3100-UPD-LOOP.
021000     EXEC SQL
021100         FETCH CSR-UPD
021200          INTO :WS-UPD-KEIYAKU-NO, :WS-UPD-ZANDAKA
021300     END-EXEC
021400     EVALUATE SQLCODE
021500         WHEN 0
021600             PERFORM 3200-UPD-ZANDAKA
021700         WHEN +100
021800             CONTINUE
021900         WHEN OTHER
022000             PERFORM 9900-SQL-ERROR
022100     END-EVALUATE.
022200*
022300 3200-UPD-ZANDAKA.
022400     EXEC SQL
022500         UPDATE FLDB.KEIYAKU
022600            SET ZANDAKA = ZANDAKA - :WS-NYUKIN-GAKU,
022700                KOSHIN_YMD = :WS-DATE
022800          WHERE CURRENT OF CSR-UPD
022900     END-EXEC
023000     IF SQLCODE NOT = 0
023100         MOVE '契約残高の更新に失敗しました' TO WS-ERR-MSG
023200         PERFORM 9900-SQL-ERROR
023300     END-IF
023400     ADD 1 TO WS-ZAN-CNT
023500     PERFORM 2900-COMMIT-CHECK.
023600*
023700*----- 集計副プログラムの呼び出し --------------------------------
023800 3300-CALL-SHUKEI.
023900     MOVE '0000' TO WS-ERR-CODE
024000     MOVE '消込集計を依頼します' TO WS-ERR-TEXT
024100     CALL WS-PGM-NAME USING WS-ERR-AREA
024200     IF RETURN-CODE NOT = 0
024300         MOVE '集計副プログラムが異常終了しました' TO WS-ERR-MSG
024400         PERFORM 9900-SQL-ERROR
024500     END-IF.
024600*
024700*----- 終了処理 --------------------------------------------------
024800 8000-END.
024900     EXEC SQL COMMIT END-EXEC
025000     DISPLAY 'FLB020 入金消込を終了します。'
025100     DISPLAY '  読込件数     = ' WS-READ-CNT
025200     DISPLAY '  消込更新件数 = ' WS-UPD-CNT
025300     DISPLAY '  消込登録件数 = ' WS-INS-CNT
025400     DISPLAY '  残高更新件数 = ' WS-ZAN-CNT
025500     DISPLAY '  ログ出力件数 = ' WS-LOG-CNT
025600     MOVE ZERO TO RETURN-CODE.
025700*
025800*----- SQL 異常時の処理 ------------------------------------------
025900 9900-SQL-ERROR.
026000     DISPLAY 'FLB020 SQL エラー SQLCODE = ' SQLCODE
026100     DISPLAY '  内容 : ' WS-ERR-MSG
026200     EXEC SQL ROLLBACK END-EXEC
026300     MOVE 12 TO RETURN-CODE
026400     GOBACK.
