//CJ202    JOB  (CJ0001),'CJ DISP FORMS',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*-----------------------------------------------------------------
//* CJ202 : DISP parameter forms
//*   NEW/CATLG/DELETE, NEW/KEEP/DELETE, OLD/KEEP/KEEP,
//*   OLD/DELETE/KEEP, a two-subparameter SHR/KEEP, an omitted
//*   status with (,CATLG,DELETE), MOD/CATLG/DELETE, MOD/DELETE/DELETE,
//*   a temporary dataset passed to the next step, and the
//*   one-subparameter forms SHR, OLD, MOD and NEW.
//*-----------------------------------------------------------------
//STEP010  EXEC PGM=IEFBR14
//NEWCATLG DD DSN=FLW.CJ202.NEWCATLG,
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,1),RLSE)
//NEWKEEP  DD DSN=FLW.CJ202.NEWKEEP,
//            DISP=(NEW,KEEP,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,1),RLSE)
//OLDKEEP  DD DSN=FL.PROD.LOADLIB,DISP=(OLD,KEEP,KEEP)
//OLDDEL   DD DSN=FLW.CJ202.SCRATCH,DISP=(OLD,DELETE,KEEP)
//SHRTWO   DD DSN=FL.PROD.LOADLIB,DISP=(SHR,KEEP)
//OMITSTAT DD DSN=FLW.CJ202.OMITSTAT,DISP=(,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,1),RLSE)
//MODDD    DD DSN=FLW.CJ202.MODFILE,
//            DISP=(MOD,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,1),RLSE)
//MODDD2   DD DSN=FLW.CJ202.MODFIL2,
//            DISP=(MOD,DELETE,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,1),RLSE)
//PASSDS   DD DSN=&&PASSTEMP,DISP=(NEW,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(5,1))
//STEP020  EXEC PGM=IEFBR14,COND=(4,LT)
//PASSCONS DD DSN=&&PASSTEMP,DISP=(OLD,DELETE)
//SGLSHR   DD DSN=FL.PROD.LOADLIB,DISP=SHR
//SGLOLD   DD DSN=FL.PROD.LOADLIB,DISP=OLD
//SGLMOD   DD DSN=FLW.CJ202.APPEND,DISP=MOD,UNIT=SYSDA,
//            SPACE=(TRK,(5,1),RLSE)
//SGLNEW   DD DSN=&&SCRATCH2,DISP=NEW,UNIT=SYSDA,
//            SPACE=(TRK,(1,1))
//
