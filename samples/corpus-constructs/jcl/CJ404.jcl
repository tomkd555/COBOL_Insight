//CJ404    JOB  (CJ0001),'DSNUTILB DB2 UTILITIES',CLASS=A,
//             MSGCLASS=X,MSGLEVEL=(1,1),NOTIFY=&SYSUID
//*-------------------------------------------------------------*
//*  CJ404 : constructs exercised (DSNUTILB, one utility per step)*
//*    - LOAD DATA INDDN(...) RESUME NO REPLACE LOG NO           *
//*      INTO TABLE ... with POSITION() column list              *
//*    - UNLOAD TABLESPACE ... FROM TABLE ...                    *
//*    - RUNSTATS TABLESPACE ...                                 *
//*    - REORG TABLESPACE ...                                    *
//*    - COPY TABLESPACE ...                                     *
//*    - CHECK DATA TABLESPACE ...                               *
//*-------------------------------------------------------------*
//STEP010  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404L'
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSUT1   DD   UNIT=SYSDA,SPACE=(CYL,(5,5))
//SORTOUT  DD   UNIT=SYSDA,SPACE=(CYL,(5,5))
//UTPRINT  DD   SYSOUT=*
//SYSERR   DD   UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSMAP   DD   UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSDISC  DD   UNIT=SYSDA,SPACE=(TRK,(5,5))
//SYSREC   DD   DSN=CJT.D260910.SCHEMA.TBL.LOADREC,DISP=SHR
//SYSIN    DD   *
  LOAD DATA INDDN(SYSREC) RESUME NO REPLACE LOG NO
      INTO TABLE SCHEMA.TBL
      (COL1 POSITION(1:8)   CHAR,
       COL2 POSITION(9:12)  CHAR,
       COL3 POSITION(13:20) DECIMAL EXTERNAL)
/*
//*
//STEP020  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404U',
//             COND=(4,LT,STEP010)
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSREC   DD   DSN=CJT.D260910.SCHEMA.TBL.UNLOAD,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD   *
  UNLOAD TABLESPACE DB.TS
      FROM TABLE SCHEMA.TBL
/*
//*
//STEP030  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404R',
//             COND=(4,LT,STEP020)
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSIN    DD   *
  RUNSTATS TABLESPACE DB.TS
      TABLE(ALL) INDEX(ALL) SHRLEVEL REFERENCE
/*
//*
//STEP040  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404G',
//             COND=(4,LT,STEP030)
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSUT1   DD   UNIT=SYSDA,SPACE=(CYL,(10,10))
//SORTOUT  DD   UNIT=SYSDA,SPACE=(CYL,(10,10))
//UTPRINT  DD   SYSOUT=*
//SYSIN    DD   *
  REORG TABLESPACE DB.TS
      SHRLEVEL REFERENCE
/*
//*
//STEP050  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404C',
//             COND=(4,LT,STEP040)
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSCOPY  DD   DSN=CJT.D260910.DB.TS.IMGCOPY,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(CYL,(5,5),RLSE)
//SYSIN    DD   *
  COPY TABLESPACE DB.TS
      FULL YES SHRLEVEL REFERENCE
/*
//*
//STEP060  EXEC PGM=DSNUTILB,PARM='DB2P,CJ404K',
//             COND=(4,LT,STEP050)
//STEPLIB  DD   DSN=DB2P.SDSNLOAD,DISP=SHR
//SYSPRINT DD   SYSOUT=*
//SYSERR   DD   DSN=CJT.D260910.SCHEMA.TBL.CHKERR,
//             DISP=(NEW,CATLG,DELETE),
//             SPACE=(TRK,(5,5),RLSE)
//SYSIN    DD   *
  CHECK DATA TABLESPACE DB.TS
      SCOPE ALL
/*
