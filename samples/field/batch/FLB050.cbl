000100*=================================================================
000200* PROGRAM-ID : FLB050
000300* 機能       : 契約明細抽出
000400* 処理概要   : 販売店単位に契約を取り出し、処理区分と更新日を
000500*              一覧へ書き出します。
000600* 起動元     : 日次夜間バッチ（IKJEFT01 の DSN RUN）
000700*=================================================================
000800 IDENTIFICATION DIVISION.
000900 PROGRAM-ID.    FLB050.
001000 AUTHOR.        FL-BATCH-TEAM.
001100 DATE-WRITTEN.  2023-04-01.
001200*
001300 ENVIRONMENT DIVISION.
001400 CONFIGURATION SECTION.
001500 SOURCE-COMPUTER. IBM-370.
001600 OBJECT-COMPUTER. IBM-370.
001700*
001800 DATA DIVISION.
001900 WORKING-STORAGE SECTION.
002000*
002100     EXEC SQL INCLUDE SQLCA END-EXEC.
002200     EXEC SQL INCLUDE FLD010 END-EXEC.
002300*
002400* 起動パラメーター
002500 01  WS-PARM-AREA.
002600     05  WS-PARM-HANBAITEN          PIC X(05).
002700     05  FILLER                     PIC X(75).
002800*
002900* ホスト変数
003000 01  WS-HOST-VARS.
003100     05  WS-HANBAITEN-CD            PIC X(05) VALUE SPACE.
003200     05  WS-KOKYAKU-NO              PIC X(08) VALUE SPACE.
003300     05  WS-KEIYAKU-NO              PIC X(08) VALUE SPACE.
003400     05  WS-KEIYAKU-NO-OK           PIC X(10) VALUE SPACE.
003500     05  WS-SHORI-KBN               PIC X(01) VALUE SPACE.
003600     05  WS-KOSHIN-YMD              PIC X(08) VALUE SPACE.
003700     05  WS-KOSHIN-YMD-IND          PIC S9(04) COMP VALUE ZERO.
003800*
003900* 作業領域
004000 01  WS-WORK-AREA.
004100     05  WS-COMMIT-CNT              PIC S9(04) COMP VALUE ZERO.
004200     05  WS-COMMIT-MAX              PIC S9(04) COMP VALUE 200.
004300     05  WS-ERR-MSG                 PIC X(60) VALUE SPACE.
004400 01  WS-COUNTERS.
004500     05  WS-MEISAI-CNT              PIC 9(07) VALUE ZERO.
004600     05  WS-KOKYAKU-CNT             PIC 9(07) VALUE ZERO.
004700*
004800* 明細抽出カーソル
004900     EXEC SQL DECLARE CSR-MEISAI CURSOR FOR
005000         SELECT KEIYAKU_NO, SHORI_KBN, KOSHIN_YMD
005100           FROM FLDB.KEIYAKU
005200          WHERE HANBAITEN_CD = :WS-HANBAITEN-CD
005300          FOR FETCH ONLY
005400     END-EXEC.
005500*
005600* 顧客抽出は COMMIT をまたぐので WITH HOLD を付けます。
005700     EXEC SQL DECLARE CSR-KOKYAKU CURSOR WITH HOLD FOR
005800         SELECT KEIYAKU_NO, KOKYAKU_NO
005900           FROM FLDB.KEIYAKU
006000          WHERE HANBAITEN_CD = :WS-HANBAITEN-CD
006100          FOR FETCH ONLY
006200     END-EXEC.
006300*
006400 PROCEDURE DIVISION.
006500*
006600*----- 主処理 ----------------------------------------------------
006700 0000-MAIN.
006800     PERFORM 1000-INIT
006900     PERFORM 2000-MEISAI-CHUSHUTSU
007000     PERFORM 3000-KOKYAKU-CHUSHUTSU
007100     PERFORM 8000-END
007200     STOP RUN.
007300*
007400*----- 初期処理 --------------------------------------------------
007500 1000-INIT.
007600     ACCEPT WS-PARM-AREA
007700     MOVE WS-PARM-HANBAITEN TO WS-HANBAITEN-CD
007800     DISPLAY 'FLB050 契約明細抽出を開始します。'
007900     DISPLAY '  販売店コード = ' WS-HANBAITEN-CD.
008000*
008100*----- 明細抽出 --------------------------------------------------
008200 2000-MEISAI-CHUSHUTSU.
008300     EXEC SQL OPEN CSR-MEISAI END-EXEC
008400     IF SQLCODE NOT = 0
008500         MOVE '明細カーソルの開始に失敗しました' TO WS-ERR-MSG
008600         PERFORM 9900-SQL-ERROR
008700     END-IF
008800     PERFORM 2100-MEISAI-LOOP UNTIL SQLCODE NOT = 0
008900     EXEC SQL CLOSE CSR-MEISAI END-EXEC.
009000*
009100 2100-MEISAI-LOOP.
009200     EXEC SQL
009300         FETCH CSR-MEISAI
009400          INTO :WS-KEIYAKU-NO-OK,
009500               :WS-SHORI-KBN,
009600               :WS-KOSHIN-YMD :WS-KOSHIN-YMD-IND
009700     END-EXEC
009800     IF SQLCODE = 0
009900         PERFORM 2200-MEISAI-1KEN
010000     END-IF.
010100*
010200 2200-MEISAI-1KEN.
010300     ADD 1 TO WS-MEISAI-CNT
010400     PERFORM 2300-KEIYAKU-SAISHUTOKU
010500     PERFORM 2900-COMMIT-CHECK.
010600*
010700* 契約番号は CHAR(10) なので受け取り側も X(10) が要ります。
010800 2300-KEIYAKU-SAISHUTOKU.
010900     EXEC SQL
011000         SELECT KOKYAKU_NO, KEIYAKU_NO
011100           INTO :WS-KOKYAKU-NO,
011200                :WS-KEIYAKU-NO
011300           FROM FLDB.KEIYAKU
011400          WHERE KEIYAKU_NO = :WS-KEIYAKU-NO-OK
011500     END-EXEC
011600     IF SQLCODE NOT = 0 AND SQLCODE NOT = +100
011700         MOVE '契約の再取得に失敗しました' TO WS-ERR-MSG
011800         PERFORM 9900-SQL-ERROR
011900     END-IF.
012000*
012100 2900-COMMIT-CHECK.
012200     ADD 1 TO WS-COMMIT-CNT
012300     IF WS-COMMIT-CNT >= WS-COMMIT-MAX
012400         EXEC SQL COMMIT END-EXEC
012500         MOVE ZERO TO WS-COMMIT-CNT
012600     END-IF.
012700*
012800*----- 顧客抽出 --------------------------------------------------
012900 3000-KOKYAKU-CHUSHUTSU.
013000     EXEC SQL OPEN CSR-KOKYAKU END-EXEC
013100     IF SQLCODE NOT = 0
013200         MOVE '顧客カーソルの開始に失敗しました' TO WS-ERR-MSG
013300         PERFORM 9900-SQL-ERROR
013400     END-IF
013500     PERFORM 3100-KOKYAKU-LOOP UNTIL SQLCODE NOT = 0
013600     EXEC SQL CLOSE CSR-KOKYAKU END-EXEC.
013700*
013800 3100-KOKYAKU-LOOP.
013900     EXEC SQL
014000         FETCH CSR-KOKYAKU
014100          INTO :WS-KEIYAKU-NO-OK, :WS-KOKYAKU-NO
014200     END-EXEC
014300     IF SQLCODE = 0
014400         ADD 1 TO WS-KOKYAKU-CNT
014500         PERFORM 2900-COMMIT-CHECK
014600     END-IF.
014700*
014800*----- 終了処理 --------------------------------------------------
014900 8000-END.
015000     EXEC SQL COMMIT END-EXEC
015100     DISPLAY 'FLB050 契約明細抽出を終了します。'
015200     DISPLAY '  明細件数     = ' WS-MEISAI-CNT
015300     DISPLAY '  顧客件数     = ' WS-KOKYAKU-CNT
015400     DISPLAY '  契約番号     = ' WS-KEIYAKU-NO
015500     DISPLAY '  契約番号全体 = ' WS-KEIYAKU-NO-OK
015600     DISPLAY '  顧客番号     = ' WS-KOKYAKU-NO
015700     DISPLAY '  処理区分     = ' WS-SHORI-KBN
015800     DISPLAY '  更新日       = ' WS-KOSHIN-YMD
015900     MOVE ZERO TO RETURN-CODE.
016000*
016100*----- SQL 異常時の処理 ------------------------------------------
016200 9900-SQL-ERROR.
016300     DISPLAY 'FLB050 SQL エラー SQLCODE=' SQLCODE
016400     DISPLAY '  ' WS-ERR-MSG
016500     EXEC SQL ROLLBACK END-EXEC
016600     MOVE 12 TO RETURN-CODE
016700     STOP RUN.
