*.jar -text
*.db -text
*.png -text
*.ico -text
*.woff2 -text
*.wasm -text
samples/seeded/encoding/*_CP93?.cbl -text
samples/field/encoding/*_CP930.cbl -text
samples/corpus-constructs/**/*_CP930.cbl -text
