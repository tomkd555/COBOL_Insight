# ルート直下は、下で許可したもの以外をすべて無視する
/*
# 公開するファイルとフォルダー（ソースからビルドするのに必要なものだけ）
!/.gitignore
!/.gitattributes
!/.gitmodules
!/LICENSE
!/README.md
!/THIRD_PARTY_NOTICES.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/src/

# 公開するフォルダーの中のテスト、開発用ツール、手動確認用のファイル
/src/**/src/test/
tests/
__tests__/
*.test.*
*.spec.*
/src/tools/
/src/gui/smoke/
/src/gui/e2e-scratch.cjs
/src/gui/ui-brief.md
/src/gui/vitest.config.ts
/src/gui/vitest.setup.ts

# Gradle
.gradle/
build/

# IDE
.idea/
*.iml

# Node(Electron GUI)
node_modules/

# 配布物の出力先(リポジトリ直下のみ)
/release/

# 修正案の既定出力先(リポジトリ直下のみ)
/fix/

# CLIの既定出力先(リポジトリ直下のみ)
/cobol-insight.db
/cobol-insight-report.txt
/cobol-insight-report.html

# GUIの開発起動がengineを走らせたときの出力先(カレントがsrc/guiになる)
/src/gui/cobol-insight.db
/src/gui/cobol-insight-report.txt
/src/gui/cobol-insight-copy-expansion.json

# graphifyの知識グラフ生成物
graphify-out/

# Claude Code(作業用ディレクトリと指示ファイル)
.claude/
/CLAUDE.md

# GUIの手動確認用データ(Windows予約デバイス名を含み、gitがindexへ入れられない)
/src/gui/devtest/

*.class

# CodeGraph のインデックス(ローカル生成物)
.codegraph/

# check_copy.py output, regenerated by the design checks
src/gui/copy-prose.md
